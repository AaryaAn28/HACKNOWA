{
  "schema_version": "2.0.0",
  "description": "Ground-truth semantic 3D classes supported by available datasets and trained models",
  "domains": {
    "terrain": {
      "description": "Topographical surface layers from ALOS DEM and Landslide4Sense",
      "classes": [
        {
          "class_name": "TERRAIN_SURFACE",
          "geometry_type": "HeightmapMesh",
          "provenance_default": "DERIVED",
          "source_dataset": "ALOS_DEM_30M"
        },
        {
          "class_name": "DEPRESSION_BASIN",
          "geometry_type": "PolygonVolume",
          "provenance_default": "DERIVED",
          "source_dataset": "Terrain_D8_Analysis"
        },
        {
          "class_name": "SLOPE_HAZARD_ZONE",
          "geometry_type": "PolygonOverlay",
          "provenance_default": "ESTIMATED",
          "model_id": "landslide_resnet18_v1",
          "source_dataset": "Landslide4Sense"
        }
      ]
    },
    "structures": {
      "description": "Building envelopes and structural footprints",
      "classes": [
        {
          "class_name": "BUILDING_RESIDENTIAL",
          "geometry_type": "ExtrudedFootprint",
          "provenance_default": "OBSERVED",
          "source_dataset": "MS_Building_Footprints"
        },
        {
          "class_name": "BUILDING_COMMERCIAL",
          "geometry_type": "ExtrudedFootprint",
          "provenance_default": "OBSERVED",
          "source_dataset": "MS_Building_Footprints"
