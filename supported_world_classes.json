        {
          "class_name": "BUILDING_INDUSTRIAL",
          "geometry_type": "ExtrudedFootprint",
          "provenance_default": "OBSERVED",
          "source_dataset": "MS_Building_Footprints"
        },
        {
          "class_name": "BUILDING_EXTRACTED",
          "geometry_type": "SegmentedMaskToPolygon",
          "provenance_default": "ESTIMATED",
          "model_id": "building_unet_v1",
          "source_dataset": "IEEE_Building_Extraction"
        }
      ]
    },
    "transportation": {
      "description": "Roadway hierarchies, intersections, and corridors",
      "classes": [
        {
          "class_name": "ROAD_MOTORWAY",
          "geometry_type": "SplineCorridor",
          "lanes": 6,
          "width_m": 24.0,
          "provenance_default": "OBSERVED",
          "source_dataset": "OpenStreetMap"
        },
        {
          "class_name": "ROAD_PRIMARY",
          "geometry_type": "SplineCorridor",
